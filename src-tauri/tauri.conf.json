{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlitzVox",
  "version": "2.0.0",
  "identifier": "io.github.hugomaulwurf76.blitzvox",
  "mainBinaryName": "BlitzVox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "publisher": "BlitzVox",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["German"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
